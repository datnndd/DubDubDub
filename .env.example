# ====================================================================
# PyVideoTrans Environment Configuration
# ====================================================================
# This file serves as a template. Copy it to `.env` to configure your keys.
# `.env` is automatically loaded on startup and is ignored by git.
# When you update keys in the WebUI Settings page, `.env` is updated automatically.
# ====================================================================

# Speech Recognition (ASR)
DEEPGRAM_API_KEY=

# Translation & LLM Providers
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Text to Speech & Models
ELEVENLABS_API_KEY=
HF_TOKEN=

# Custom Base URLs (Optional)
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GEMINI_BASE_URL=

# Network Proxy (Optional)
# HTTPS_PROXY=http://127.0.0.1:7890
